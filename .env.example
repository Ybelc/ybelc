# URL pública do site (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://ybelc.com.br

# (Opcional/legado) URL de um app externo — não exibida na home atual
NEXT_PUBLIC_ACCESS_APP_URL=

# URL da API backend usada pelos formulários (projeto, chat e novidades).
# Sem ela, os formulários exibem "canal de envio ainda não configurado".
NEXT_PUBLIC_API_URL=http://localhost:8000
